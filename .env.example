# LogSentinel configuration

# Database
DB_PATH=data/sentinel.db

# Log source
LOG_PATH=/var/log/auth.log

# Detection
BLOCK_THRESHOLD=5

# Firewall: noop (test) or ufw (production)
FIREWALL_STRATEGY=noop

# Test mode
TEST_MODE=true
CLI_MODE=true

# GeoIP: mock (test) or maxmind (production)
GEOIP_PROVIDER=mock

# Web
WEB_HOST=0.0.0.0
WEB_PORT=5000
